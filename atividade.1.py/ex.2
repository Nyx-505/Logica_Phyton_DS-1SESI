# EX6
# Use a função complex() para criar
# um número complexo com parte real 3
# e parte imaginária 5.

complex(3, 5)
complexo = 3 + 5j

print("Valor:", complexo)
print("Tipo:", (complexo))
print("Parte Real:", complexo.real)
print("Parte Imaginaria:", complexo.imag)


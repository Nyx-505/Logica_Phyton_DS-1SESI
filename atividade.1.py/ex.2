# EX1
# O usuário digitou "25" como sua idade em um formulário.
# Converta para inteiro e calcule a idade que ele terá
# daqui a 5 anos.

idade_string = 25
idade_inteiro = int(idade_string) 
idade_futura = idade_inteiro + 5
print("Idade Atual:", idade_inteiro)
print("Idade após 5 anos:", idade_futura)

print("================================")
